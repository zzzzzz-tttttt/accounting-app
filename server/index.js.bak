import 'dotenv/config'
import express from 'express'
import cors from 'cors'
import multer from 'multer'
import OpenAI from 'openai'
import { readFileSync } from 'fs'

const app = express()
app.use(cors())
app.use(express.json({ limit: '20mb' }))

const upload = multer({ storage: multer.memoryStorage(), limits: { fileSize: 10 * 1024 * 1024 } })

const DEFAULT_API_KEY = process.env.SILICONFLOW_API_KEY
const VISION_MODEL = process.env.VISION_MODEL || 'Qwen/Qwen3-VL-32B-Instruct'
const TEXT_MODEL = process.env.TEXT_MODEL || 'deepseek-ai/DeepSeek-V3'

// 创建客户端（用前端传来的 Key 或默认 Key）
function getClient(apiKey) {
  const key = apiKey || DEFAULT_API_KEY
  if (!key) throw new Error('未配置 API Key')
  return new OpenAI({ apiKey: key, baseURL: 'https://api.siliconflow.cn/v1' })
}

function buildSystemPrompt() {
  const today = new Date().toISOString().split('T')[0]
  const thisYear = new Date().getFullYear()
  return `你是一个专业的记账助手。请仔细分析这张账单截图，提取出所有的交易记录。
今天的日期是 ${today}，今年是 ${thisYear} 年。

请按以下 JSON 格式返回，只返回 JSON，不要任何其他文字：
{
  "transactions": [
    {
      "date": "${today}",
      "amount": 238.50,
      "type": "expense",
      "tag": "餐饮",
      "note": "海底捞火锅"
    }
  ]
}

规则：
1. date: 交易日期，格式 YYYY-MM-DD。如果截图中有日期就提取完整的日期。如果只有月日没有年，年份用 ${thisYear} 年。如果完全没有日期，用 ${today}。
2. amount: 金额数字，不带货币符号。如果是支出/消费/付款，type 为 "expense"；如果是收入/入账/退款/工资/红包收入，type 为 "income"。
3. tag: 从以下分类中选择最匹配的：
   支出分类：餐饮、水果零食、买菜、烟酒、购物、穿搭美容、生活日用、家居家电、交通、爱车、酒店旅行、休闲娱乐、网络虚拟、运动、住房、生活服务、养娃、宠物、人情社交、发红包、学习教育、医疗保健、金融保险、转账、公益、其他
   收入分类：工资薪资、奖金、兼职收入、投资收益、其他收入
4. note: 简短备注，如商家名称或交易描述（不超过20字）
5. 如果截图中包含多笔交易，全部提取出来
6. 忽略页面顶部的余额、广告等非交易信息
7. 如果确实无法识别任何交易，返回 {"transactions": []}`
}

app.post('/api/ocr', upload.single('image'), async (req, res) => {
  try {
    if (!req.file) {
      return res.status(400).json({ ok: false, error: '未收到图片文件' })
    }

    const apiKey = req.body.apiKey
    const cli = getClient(apiKey)
    const base64 = req.file.buffer.toString('base64')
    const mimeType = req.file.mimetype || 'image/png'

    const response = await cli.chat.completions.create({
      model: VISION_MODEL,
      messages: [
        { role: 'system', content: buildSystemPrompt() },
        {
          role: 'user',
          content: [
            {
              type: 'image_url',
              image_url: {
                url: `data:${mimeType};base64,${base64}`,
              },
            },
            {
              type: 'text',
              text: '请识别这张账单截图中的所有交易记录。',
            },
          ],
        },
      ],
      max_tokens: 2048,
      temperature: 0.1,
    })

    const raw = response.choices?.[0]?.message?.content || ''
    console.log('=== AI 原始返回 ===')
    console.log(raw)
    console.log('===================')
    // 尝试从 markdown 代码块中提取 JSON
    let jsonStr = raw.trim()
    const codeBlockMatch = jsonStr.match(/```(?:json)?\s*([\s\S]*?)```/)
    if (codeBlockMatch) {
      jsonStr = codeBlockMatch[1].trim()
    }

    let parsed
    try {
      parsed = JSON.parse(jsonStr)
    } catch {
      // 尝试修复常见问题：尾部逗号、单引号等
      try {
        const cleaned = jsonStr
          .replace(/,\s*}/g, '}')
          .replace(/,\s*]/g, ']')
        parsed = JSON.parse(cleaned)
      } catch {
        return res.json({ ok: false, error: 'AI 返回格式解析失败', raw })
      }
    }

    const transactions = (parsed.transactions || []).map(t => ({
      date: t.date || new Date().toISOString().split('T')[0],
      amount: typeof t.amount === 'number' ? t.amount : parseFloat(t.amount) || 0,
      type: t.type === 'income' ? 'income' : 'expense',
      tag: t.tag || '其他',
      note: (t.note || '').slice(0, 20),
    }))

    // 为前端补充 superCat 和 superEmoji 信息
    const CATEGORY_MAP = {
      // 支出
      '餐饮': { superCat: '吃喝', emoji: '🍚' },
      '水果零食': { superCat: '吃喝', emoji: '🍎' },
      '买菜': { superCat: '吃喝', emoji: '🥬' },
      '烟酒': { superCat: '吃喝', emoji: '🍺' },
      '购物': { superCat: '购物消费', emoji: '🛒' },
      '穿搭美容': { superCat: '购物消费', emoji: '👗' },
      '生活日用': { superCat: '购物消费', emoji: '🧴' },
      '家居家电': { superCat: '购物消费', emoji: '🏠' },
      '交通': { superCat: '出行交通', emoji: '🚇' },
      '爱车': { superCat: '出行交通', emoji: '🚗' },
      '酒店旅行': { superCat: '出行交通', emoji: '🏨' },
      '休闲娱乐': { superCat: '休闲娱乐', emoji: '🎮' },
      '网络虚拟': { superCat: '休闲娱乐', emoji: '📱' },
      '运动': { superCat: '休闲娱乐', emoji: '⚽' },
      '住房': { superCat: '居住生活', emoji: '🏡' },
      '生活服务': { superCat: '居住生活', emoji: '📦' },
      '养娃': { superCat: '家庭人际', emoji: '👶' },
      '宠物': { superCat: '家庭人际', emoji: '🐱' },
      '人情社交': { superCat: '家庭人际', emoji: '🎁' },
      '发红包': { superCat: '家庭人际', emoji: '🧧' },
      '学习教育': { superCat: '成长提升', emoji: '📚' },
      '医疗保健': { superCat: '成长提升', emoji: '💊' },
      '金融保险': { superCat: '金融财务', emoji: '💰' },
      '转账': { superCat: '金融财务', emoji: '💳' },
      '公益': { superCat: '公益其他', emoji: '❤️' },
      '其他': { superCat: '公益其他', emoji: '📝' },
      // 收入
      '工资薪资': { superCat: '收入', emoji: '💼' },
      '奖金': { superCat: '收入', emoji: '🎉' },
      '兼职收入': { superCat: '收入', emoji: '💻' },
      '投资收益': { superCat: '收入', emoji: '📈' },
      '其他收入': { superCat: '收入', emoji: '💵' },
    }

    const enriched = transactions.map(t => {
      const cat = CATEGORY_MAP[t.tag] || { superCat: '公益其他', emoji: '📝' }
      return {
        ...t,
        superCat: cat.superCat,
        superEmoji: cat.emoji,
      }
    })

    res.json({ ok: true, transactions: enriched })
  } catch (err) {
    console.error('OCR error:', err.message)
    const msg = err.status === 401 ? 'API Key 无效，请检查设置' :
                err.status === 403 ? 'API Key 无权访问该模型' :
                '服务内部错误，请稍后重试'
    res.status(500).json({ ok: false, error: msg })
  }
})

// 文字解析接口（AI 对话记账）
app.post('/api/parse-text', async (req, res) => {
  try {
    const { text, apiKey } = req.body
    const cli = getClient(apiKey)
    if (!text) return res.status(400).json({ ok: false, error: '未收到文字' })

    const today = new Date().toISOString().split('T')[0]
    const thisYear = new Date().getFullYear()

    const response = await cli.chat.completions.create({
      model: TEXT_MODEL,
      messages: [
        { role: 'system', content: `你是一个记账助手。从用户的自然语言中提取交易记录。今天的日期是 ${today}，今年是 ${thisYear} 年。

返回 JSON 格式（只返回 JSON）：
{
  "transactions": [
    { "date": "${today}", "amount": 238.50, "type": "expense", "tag": "餐饮", "note": "海底捞" }
  ]
}

规则：
- 支出分类：餐饮、水果零食、买菜、烟酒、购物、穿搭美容、生活日用、家居家电、交通、爱车、酒店旅行、休闲娱乐、网络虚拟、运动、住房、生活服务、养娃、宠物、人情社交、发红包、学习教育、医疗保健、金融保险、转账、公益、其他
- 收入分类：工资薪资、奖金、兼职收入、投资收益、其他收入
- 金额不带货币符号，type 选 expense 或 income
- 如果用户提到多笔交易，全部提取` },
        { role: 'user', content: text },
      ],
      max_tokens: 1024,
      temperature: 0.1,
    })

    const raw = response.choices?.[0]?.message?.content || ''
    console.log('=== 文字解析 ===')
    console.log(raw)

    let jsonStr = raw.trim()
    const m = jsonStr.match(/```(?:json)?\s*([\s\S]*?)```/)
    if (m) jsonStr = m[1].trim()

    let parsed
    try { parsed = JSON.parse(jsonStr) } catch {
      try { parsed = JSON.parse(jsonStr.replace(/,\s*}/g, '}').replace(/,\s*]/g, ']')) } catch {
        return res.json({ ok: false, error: 'AI 返回格式解析失败', raw })
      }
    }

    const CATEGORY_MAP = {
      '餐饮': { superCat: '吃喝', emoji: '🍚' },
      '水果零食': { superCat: '吃喝', emoji: '🍎' },
      '买菜': { superCat: '吃喝', emoji: '🥬' },
      '烟酒': { superCat: '吃喝', emoji: '🍺' },
      '购物': { superCat: '购物消费', emoji: '🛒' },
      '穿搭美容': { superCat: '购物消费', emoji: '👗' },
      '生活日用': { superCat: '购物消费', emoji: '🧴' },
      '家居家电': { superCat: '购物消费', emoji: '🏠' },
      '交通': { superCat: '出行交通', emoji: '🚇' },
      '爱车': { superCat: '出行交通', emoji: '🚗' },
      '酒店旅行': { superCat: '出行交通', emoji: '🏨' },
      '休闲娱乐': { superCat: '休闲娱乐', emoji: '🎮' },
      '网络虚拟': { superCat: '休闲娱乐', emoji: '📱' },
      '运动': { superCat: '休闲娱乐', emoji: '⚽' },
      '住房': { superCat: '居住生活', emoji: '🏡' },
      '生活服务': { superCat: '居住生活', emoji: '📦' },
      '养娃': { superCat: '家庭人际', emoji: '👶' },
      '宠物': { superCat: '家庭人际', emoji: '🐱' },
      '人情社交': { superCat: '家庭人际', emoji: '🎁' },
      '发红包': { superCat: '家庭人际', emoji: '🧧' },
      '学习教育': { superCat: '成长提升', emoji: '📚' },
      '医疗保健': { superCat: '成长提升', emoji: '💊' },
      '金融保险': { superCat: '金融财务', emoji: '💰' },
      '转账': { superCat: '金融财务', emoji: '💳' },
      '公益': { superCat: '公益其他', emoji: '❤️' },
      '其他': { superCat: '公益其他', emoji: '📝' },
      '工资薪资': { superCat: '收入', emoji: '💼' },
      '奖金': { superCat: '收入', emoji: '🎉' },
      '兼职收入': { superCat: '收入', emoji: '💻' },
      '投资收益': { superCat: '收入', emoji: '📈' },
      '其他收入': { superCat: '收入', emoji: '💵' },
    }

    const transactions = (parsed.transactions || []).map(t => {
      const cat = CATEGORY_MAP[t.tag] || { superCat: '公益其他', emoji: '📝' }
      return {
        date: t.date || today,
        amount: typeof t.amount === 'number' ? t.amount : parseFloat(t.amount) || 0,
        type: t.type === 'income' ? 'income' : 'expense',
        tag: t.tag || '其他',
        superCat: cat.superCat,
        superEmoji: cat.emoji,
        note: (t.note || '').slice(0, 20),
      }
    })

    res.json({ ok: true, transactions })
  } catch (err) {
    console.error('Parse text error:', err.message)
    const msg = err.status === 401 ? 'API Key 无效' : '服务内部错误'
    res.status(500).json({ ok: false, error: msg })
  }
})

// AI 命令解析（支持修改已记录的账单）
app.post('/api/ai-command', async (req, res) => {
  try {
    const { text, transactions, apiKey } = req.body
    const cli = getClient(apiKey)
    if (!text) return res.status(400).json({ ok: false, error: '未收到命令' })

    const today = new Date().toISOString().split('T')[0]
    const thisYear = new Date().getFullYear()

    // 提供现有账单摘要给 AI
    const summary = transactions?.length > 0
      ? transactions.slice(0, 50).map(t => ({
          id: t.id, date: t.date, amount: t.amount, type: t.type,
          tag: t.tag, superCat: t.superCat, note: t.note
        }))
      : []

    const response = await cli.chat.completions.create({
      model: TEXT_MODEL,
      messages: [
        { role: 'system', content: `你是记账助手，理解用户的修改或记录命令。今天的日期是 ${today}。

用户可能要求：
1. 记录新账单 → action: "create"
2. 修改已有账单 → action: "modify"
3. 删除已有账单 → action: "delete"

对于 create：提取新交易列表。
对于 modify：根据用户描述（日期、关键词、金额等）找到匹配的已有账单，列出需修改的 id 和修改内容。
对于 delete：找到匹配的账单 id 列表。

只返回 JSON：
{
  "action": "create|modify|delete",
  "transactions": [新建账单用],
  "modifications": [{ "id": "原账单id", "changes": { "tag": "餐饮", "date": "2026-06-29", "note": "新备注" } }],
  "deleteIds": ["id1", "id2"]
}

修改时可改字段：date, amount, type, tag, note
分类选项（tag）：餐饮、水果零食、买菜、烟酒、购物、穿搭美容、生活日用、家居家电、交通、爱车、酒店旅行、休闲娱乐、网络虚拟、运动、住房、生活服务、养娃、宠物、人情社交、发红包、学习教育、医疗保健、金融保险、转账、公益、其他、工资薪资、奖金、兼职收入、投资收益、其他收入
日期格式：YYYY-MM-DD。如果只有月日没有年，年份用 ${thisYear}。` },
        { role: 'user', content: `现有账单：${JSON.stringify(summary)}\n\n用户命令：${text}` },
      ],
      max_tokens: 2048,
      temperature: 0.1,
    })

    const raw = response.choices?.[0]?.message?.content || ''
    console.log('=== AI 命令解析 ===')
    console.log(raw)

    let jsonStr = raw.trim()
    const m = jsonStr.match(/```(?:json)?\s*([\s\S]*?)```/)
    if (m) jsonStr = m[1].trim()

    let parsed
    try { parsed = JSON.parse(jsonStr) } catch {
      try { parsed = JSON.parse(jsonStr.replace(/,\s*}/g, '}').replace(/,\s*]/g, ']')) } catch {
        return res.json({ ok: false, error: 'AI 返回格式解析失败', raw })
      }
    }

    res.json({ ok: true, ...parsed })
  } catch (err) {
    console.error('AI command error:', err.message)
    const msg = err.status === 401 ? 'API Key 无效' : '服务内部错误'
    res.status(500).json({ ok: false, error: msg })
  }
})

const PORT = process.env.PORT || 3001
app.listen(PORT, () => {
  console.log(`🧠 OCR 后端已启动: http://localhost:${PORT}`)
})
